{
  "name": "face-changer-app",
  "version": "0.1.0",
  "description": "Realtime face changer with feminine-style filters.",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^29.4.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.codex.facechanger",
    "productName": "FaceChanger",
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "main.js"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
